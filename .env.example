# MMR engine — environment template. Copy to .env and replace every value.
# Settings fail fast at boot on any missing or empty secret (src/config.py).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Environment ──────────────────────────────────────────────────────────────
# Defaults to "production" when unset. "development" enables /docs and allows
# API_AUTH_DISABLED (never honoured outside development).
ENVIRONMENT=development
LOG_LEVEL=INFO
API_AUTH_DISABLED=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Owner account (migrations only) and one password per application role.
# docker-compose builds the role DSNs from these; set the POSTGRES_*_DSN
# variables yourself only when running processes outside Docker.
POSTGRES_SUPERUSER_PASSWORD=replace-me
RECON_PIPELINE_PASSWORD=replace-me
RECON_API_PASSWORD=replace-me
RECON_READONLY_PASSWORD=replace-me
# POSTGRES_PIPELINE_DSN=postgresql+asyncpg://reconciliation_pipeline:...@localhost:5432/reconciliation
# POSTGRES_API_DSN=postgresql+asyncpg://reconciliation_api_user:...@localhost:5432/reconciliation
# POSTGRES_READONLY_DSN=postgresql+asyncpg://reconciliation_readonly:...@localhost:5432/reconciliation

# ── MinIO (Bronze) ───────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=mmr-local
MINIO_SECRET_KEY=replace-me-at-least-8-chars

# ── PSP credentials (use sandbox keys locally) ───────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_replace_me
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace_me
FLUTTERWAVE_SECRET_HASH=replace-me

# ── PII tokenization (>= 32 chars) ───────────────────────────────────────────
# Keyed HMAC for counterparty-name tokens. Rotating it makes existing tokens
# unmatchable against new ones; see docs/adr/0001-pii-tokenization.md.
PII_TOKENIZATION_KEY=replace-me-with-a-random-string-of-32-plus-chars

# ── Optional integrations ────────────────────────────────────────────────────
# FX: only needed for non-NGN events (https://www.exchangerate-api.com/).
FX_PROVIDER_API_KEY=
# Slack incoming webhook for critical / high-exposure discrepancies.
SLACK_WEBHOOK_URL=
ALERT_EXPOSURE_THRESHOLD_NGN=100000

# ── Matching (defaults shown) ────────────────────────────────────────────────
MATCHING_PRIMARY_WINDOW_HOURS=72
MATCHING_SECONDARY_WINDOW_HOURS=168
MATCHING_SECONDARY_CONFIDENCE_THRESHOLD=0.75
MATCHING_AMOUNT_TOLERANCE_PCT=0.05
MATCHING_SCHEDULE_MINUTES=5

# ── API ──────────────────────────────────────────────────────────────────────
API_RATE_LIMIT_PER_MINUTE=100
API_CORS_ORIGINS=["http://localhost:3000"]
# Key the dashboard's server-side proxy sends (create with scripts/create_api_key.py).
DASHBOARD_API_KEY=

# ── Monitoring overlay ───────────────────────────────────────────────────────
GRAFANA_PASSWORD=replace-me
