# MMR Dashboard — environment variables
# Copy to .env.local for local development.

# ── Server-side only (never sent to the browser) ─────────────────────────────
# Base URL of the MMR API. The dashboard's /api/mmr/* proxy forwards here.
MMR_API_URL=http://localhost:8000

# Optional. Injected as X-API-Key by the server-side proxy.
MMR_API_KEY=

# ── Build-time, public ───────────────────────────────────────────────────────
# "true" builds a dashboard that serves bundled demo fixtures instead of
# calling the API. Every page then shows a persistent "Demo data" banner.
NEXT_PUBLIC_DEMO_MODE=false
